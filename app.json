{
  "expo": {
    "name": "ShopMyNest",
    "slug": "the-nest-marketplace",
    "version": "1.0.142",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "thenest",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shopmynest",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Upload product photos to your shop"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.shopmynest",
      "googleServicesFile": "./google-services.json",
      "versionCode": 108,
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "shopmynest.com",
              "pathPrefix": "/product"
            },
            {
              "scheme": "https",
              "host": "shopmynest.com",
              "pathPrefix": "/shop"
            },
            {
              "scheme": "https",
              "host": "shopmynest.com",
              "pathPrefix": "/vendors"
            },
            {
              "scheme": "https",
              "host": "shopmynest.com",
              "pathPrefix": "/blog"
            },
            {
              "scheme": "https",
              "host": "www.shopmynest.com",
              "pathPrefix": "/product"
            },
            {
              "scheme": "https",
              "host": "www.shopmynest.com",
              "pathPrefix": "/shop"
            },
            {
              "scheme": "https",
              "host": "www.shopmynest.com",
              "pathPrefix": "/vendors"
            },
            {
              "scheme": "https",
              "host": "www.shopmynest.com",
              "pathPrefix": "/blog"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Upload product photos to your shop",
          "cameraPermission": false
        }
      ],
      "expo-web-browser",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.shopmynest.app",
          "enableGooglePay": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "088331f1-979b-41fe-92b4-e04e182e8b5d"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "achick22"
  }
}
