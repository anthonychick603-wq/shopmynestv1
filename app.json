{
  "expo": {
    "name": "The Nest",
    "slug": "the-nest-marketplace",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "thenest",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F3F0"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.thenest.marketplace",
      "versionCode": 8,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#294B32"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "The Nest uses your photos when you upload a profile photo, shop banner, blog image, or product listing.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#294B32"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#F6F3F0",
          "barStyle": "dark",
          "borderColor": "#B4C96F",
          "visibility": "visible",
          "behavior": "inset-swipe",
          "position": "relative"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.thenest.marketplace",
          "enableGooglePay": true
        }
      ]
    ],
    "extra": {
      "siteUrl": "https://shopmynest.com"
    },
    "backgroundColor": "#F6F3F0"
  }
}
