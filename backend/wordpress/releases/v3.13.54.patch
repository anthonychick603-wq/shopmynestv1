+    /**
+     * v3.13.54 — RESTORED: emit an operational alert to the site admin.
+     *
+     * Historical background: five hot paths across the plugin have been calling
+     * `MNU_Ops::notify_admin( $subject, $body, $context )` for months — bank
+     * account change (class-mnu-bank-account.php), Stripe dispute webhook
+     * (class-mnu-native-checkout.php), Shippo void error / polling timeout
+     * (class-mnu-auto-label.php), and seller debit posting
+     * (class-mnu-seller-debit.php). The method itself was NEVER declared on
+     * the MNU_Ops class, so every one of those call sites fataled with
+     * "Error: Call to undefined method MNU_Ops::notify_admin()" the moment its
+     * branch triggered. `class_exists('MNU_Ops')` guards passed (class does
+     * exist) so the guard was useless. On WordPress.com Atomic this fatal was
+     * rendered as the raw wpcomsh error template and leaked through the mobile
+     * REST client into the app UI.
+     *
+     * This implementation sends the message via three cheap independent
+     * channels so a single delivery failure never masks the alert:
+     *   1) Email to the site admin_email (falls back to WP option).
+     *   2) An in-DB alert row appended to the `mnu_admin_alerts` option,
+     *      capped at 100 entries so a runaway alert loop cannot grow the row
+     *      unbounded.
+     *   3) A native push (via notify_user) to every user with
+     *      `mnu_receive_admin_alerts=1` in user meta, plus the admin_email's
+     *      matching WP user account if any.
+     *
+     * All three deliveries are wrapped in a Throwable boundary so this
+     * function can never itself become a source of REST fatals.
+     *
+     * @param string $subject Short subject line, plain text.
+     * @param string $body    Body — allowed newlines; sanitized for wp_mail.
+     * @param array  $data    Optional structured context — persisted with the
+     *                        alert and forwarded to notify_user.
+     */
+    public static function notify_admin( string $subject, string $body, array $data = array() ): void {
+        $subject = trim( $subject ) !== '' ? $subject : '[ShopMyNest] Operational alert';
+        $body    = (string) $body;
+        $data    = is_array( $data ) ? $data : array();
+
+        // 1) Email to admin_email. Wrapped — wp_mail can throw when SMTP
+        //    plugins are misconfigured.
+        try {
+            $admin_email = get_option( 'admin_email' );
+            if ( is_string( $admin_email ) && $admin_email !== '' ) {
+                $footer = $data ? "\n\nContext:\n" . wp_json_encode( $data ) : '';
+                wp_mail(
+                    $admin_email,
+                    sanitize_text_field( $subject ),
+                    $body . $footer
+                );
+            }
+        } catch ( \Throwable $e ) { // phpcs:ignore Generic.CodeAnalysis.EmptyStatement.DetectedCatch
+            // Swallow — email is best-effort.
+        }
+
+        // 2) Persist to the admin-alerts audit ring.
+        try {
+            $alerts = get_option( 'mnu_admin_alerts', array() );
+            if ( ! is_array( $alerts ) ) { $alerts = array(); }
+            $alerts[] = array(
+                't'       => gmdate( 'c' ),
+                'subject' => (string) $subject,
+                'body'    => (string) $body,
+                'data'    => $data,
+            );
+            update_option( 'mnu_admin_alerts', array_slice( $alerts, -100 ), false );
+        } catch ( \Throwable $e ) { // phpcs:ignore Generic.CodeAnalysis.EmptyStatement.DetectedCatch
+            // Swallow — audit ring is best-effort.
+        }
+
+        // 3) Native push to any user opted in to admin alerts, plus the WP
+        //    account matching admin_email if it exists.
+        try {
+            $recipient_ids = array();
+            $admin_email   = get_option( 'admin_email' );
+            if ( is_string( $admin_email ) && $admin_email !== '' ) {
+                $u = get_user_by( 'email', $admin_email );
+                if ( $u ) { $recipient_ids[] = (int) $u->ID; }
+            }
+            if ( function_exists( 'get_users' ) ) {
+                $opt_ins = get_users(
+                    array(
+                        'meta_key'   => 'mnu_receive_admin_alerts',
+                        'meta_value' => '1',
+                        'fields'     => 'ID',
+                        'number'     => 50,
+                    )
+                );
+                foreach ( (array) $opt_ins as $uid ) {
+                    $recipient_ids[] = (int) $uid;
+                }
+            }
+            foreach ( array_unique( array_filter( $recipient_ids ) ) as $uid ) {
+                self::notify_user( (int) $uid, $subject, $body, array_merge( array( 'source' => 'admin_alert' ), $data ) );
+            }
+        } catch ( \Throwable $e ) { // phpcs:ignore Generic.CodeAnalysis.EmptyStatement.DetectedCatch
+            // Swallow — push is best-effort.
+        }
+    }
 }
