diff -urN scratch/plugin-v53/mynest-unified-marketplace/includes/class-mnu-ops.php scratch/plugin-new/mynest-unified-marketplace/includes/class-mnu-ops.php
--- scratch/plugin-v53/mynest-unified-marketplace/includes/class-mnu-ops.php	2026-08-31 23:15:22.760924958 +0000
